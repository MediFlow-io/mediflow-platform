# Copy to .env to override defaults. Docker Compose reads this file automatically;
# Django run locally does NOT (export variables in your shell instead).
# Every value below is a development default. Never use these in production.

# --- Django core API ---
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5500,http://127.0.0.1:5500
# Create demo departments and accounts on startup (Docker only). Set false outside local dev.
SEED_DEMO=true

# --- PostgreSQL (Docker sets these; leave unset locally to use SQLite) ---
# POSTGRES_DB=mediflow
# POSTGRES_USER=mediflow
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# --- JWT (RS256) ---
# In DEBUG a key pair is generated into JWT_KEYS_DIR if missing.
# In production set JWT_PRIVATE_KEY/JWT_PUBLIC_KEY (PEM, "\n" escapes allowed) or mount PEM files.
# JWT_KEYS_DIR=.keys
# JWT_ISSUER=mediflow-core
# JWT_AUDIENCE=mediflow
# JWT_ACCESS_MINUTES=10
# JWT_REFRESH_DAYS=7

# --- AI service (shared secret between Django and the FastAPI service) ---
AI_SERVICE_TOKEN=mediflow-dev-internal-token
# AI_SERVICE_URL=http://localhost:8001
# AI_SERVICE_TIMEOUT=3
# AI_RATE_LIMIT=30/min
# AI_ENV=development
# EMERGENCY_NUMBER=112

# --- Docker ---
# WEB_PORT=8080
